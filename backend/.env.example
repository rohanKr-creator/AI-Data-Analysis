# Environment: development, staging, production
ENVIRONMENT=development

# Application Info
PROJECT_NAME="AI Data Analyst"
VERSION="0.1.0"
API_V1_STR=/api/v1

# CORS Origins (JSON list or comma-separated strings)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Upload Settings
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
UPLOAD_DIR=data/uploads

# ==========================================
# PostgreSQL Database Settings
# ==========================================
# Option A: Supabase Cloud PostgreSQL (Session Pooler / IPv4)
POSTGRES_HOST=aws-0-[region].pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.[your-project-ref]
POSTGRES_PASSWORD=your_supabase_db_password_here
POSTGRES_DB=postgres

# Database Connection URLs:
# Note: If your password contains special characters (@, :, /, %), URL-encode them in DATABASE_URL / ASYNC_DATABASE_URL
DATABASE_URL=postgresql+psycopg2://postgres.[your-project-ref]:your_supabase_db_password_here@aws-0-[region].pooler.supabase.com:5432/postgres
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres.[your-project-ref]:your_supabase_db_password_here@aws-0-[region].pooler.supabase.com:5432/postgres

# Option B: Local PostgreSQL (Alternative)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_local_postgres_password
# POSTGRES_DB=ai_data_analyst
# DATABASE_URL=postgresql+psycopg2://postgres:your_local_postgres_password@localhost:5432/ai_data_analyst
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:your_local_postgres_password@localhost:5432/ai_data_analyst

# ==========================================
# Google Gemini AI Settings
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ==========================================
# Supabase Cloud Storage Settings
# ==========================================
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_NAME=datasets
