# Environment: development, staging, production
ENVIRONMENT=development

# Application Info
PROJECT_NAME="AI Data Analyst"
VERSION="0.1.0"
API_V1_STR=/api/v1

# CORS Origins (JSON list or comma-separated strings)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Upload Settings
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
UPLOAD_DIR=data/uploads

# ==========================================
# PostgreSQL Database Settings
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ai_data_analyst

# Database Connection URLs:
DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/ai_data_analyst
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@localhost:5432/ai_data_analyst
