# ==========================================
# Frontend Environment Configuration
# ==========================================

# Backend API base URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase Auth Configuration (Client-side / Public)
# IMPORTANT: Use the public "anon" key only. NEVER expose your service_role key here.
VITE_SUPABASE_URL=https://[your-project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe Publishable Key (for Pro tier subscription upgrades)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Developer/Admin email for developer diagnostics & JWT test panel visibility
# Note: Used for UI decluttering only; actual security is enforced by backend JWT validation
VITE_ADMIN_EMAIL=admin@example.com
